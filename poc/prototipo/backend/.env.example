# URL del módulo LLM de la PoC (POST /ask).
LLM_URL=http://localhost:8002
# Segundos que se espera la respuesta del LLM.
LLM_TIMEOUT_SECONDS=180
# 1 = borradores falsos sin llamar al LLM (para probar la interfaz).
MOCK=0
# 1 = carga preguntas ficticias ya publicadas para probar la vista del revisor; 0 = arrancar vacío.
SEMILLA=1
