# ID de cliente y secreto: cópialos del JSON descargado desde Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/callback
# Secreto del JWT (HS256): el mismo valor debe ir en el backend.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Firma la cookie de sesión del flujo OIDC. Genera uno con: openssl rand -hex 32
SESSION_SECRET=
