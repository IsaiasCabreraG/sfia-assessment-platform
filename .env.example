# Base de datos (la crea db/setup.sh)
DB_NAME=sfia
DB_USER=sfia_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# JWT HS256 compartido por todos los módulos
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Duración del refresh token (7 días); cada uso lo rota
REFRESH_TTL_SECONDS=604800

# Google OIDC (módulo identity)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/callback
SESSION_SECRET=

# Portales (React): origen permitido por CORS y destino de la redirección tras el login
PORTAL_DOCENTE_URL=http://localhost:5173/docente/
PORTAL_VALIDADOR_URL=http://localhost:5173/validador/
CORS_ORIGINS=http://localhost:5173

# URLs entre módulos
CATALOG_URL=http://localhost:8002
LLM_URL=http://localhost:8003

# Módulo llm: quién responde. `groq` (API, clave gratuita en console.groq.com) o `cli` (la CLI de Claude)
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096
# Solo modelos de razonamiento (gpt-oss): low | medium | high. `low` deja más tokens para la respuesta
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.6
# Solo para LLM_PROVIDER=cli: comando de la CLI y carpeta neutra desde la que se lanza
LLM_CLI_COMMAND="claude -p"
LLM_TIMEOUT_SECONDS=300
LLM_CLI_CWD=

# Log de las llamadas a la IA (SOLO DESARROLLO; en producción debe estar apagado): con 1, cada intento deja en
# logs/ia/AAAA-MM-DD.jsonl el prompt, la respuesta, el resultado de la validación y los datos de la llamada.
# Se ve con: bash tools/run_python.sh tools/ver_log_ia.py
LOG_IA=0
# Nombre del experimento, para agrupar y comparar corridas (por ejemplo, gpt-oss-vs-llama)
LOG_IA_ETIQUETA=
